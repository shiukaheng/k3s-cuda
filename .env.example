K3S_ROLE=agent
K3S_SERVER=k3s-server
K3S_TOKEN=replace-with-the-server-token

TS_AUTHKEY=tskey-auth-replace-me
TS_HOSTNAME=k3s-worker-1
TS_CONTROL_URL=

# Optional. If unset, the stable Tailscale IP determines the Kubernetes node name.
K3S_NODE_NAME=

# GPU hosts: change this to compose.yaml:compose.gpu.yaml
COMPOSE_FILE=compose.yaml
